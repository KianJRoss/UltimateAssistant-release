{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "claude-context": {
      "command": "npx",
      "args": [
        "-y",
        "claude-context"
      ]
    }
  }
}
